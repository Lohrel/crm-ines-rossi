# Copie este arquivo para ".env" e preencha os valores.
# O arquivo ".env" nunca vai para o GitHub (está no .gitignore).

# Gere uma chave com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-esta-chave

# Use "false" no servidor do escritório.
DJANGO_DEBUG=false

# Nomes pelos quais o sistema é acessado, separados por vírgula.
# Ex.: nome do servidor na rede, IP fixo e nome no Tailscale.
DJANGO_ALLOWED_HOSTS=crm.local,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://crm.local,https://localhost

# Banco de dados (PostgreSQL)
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Endereço usado pelo servidor HTTPS (Caddy)
CRM_HOSTNAME=crm.local

# Senha que criptografa os backups. Guarde-a também fora do servidor
# (ex.: gerenciador de senhas). Sem ela, os backups não podem ser abertos.
BACKUP_PASSPHRASE=troque-esta-senha-de-backup
# Horário do backup diário (formato HH:MM, fuso de São Paulo)
BACKUP_TIME=02:00
